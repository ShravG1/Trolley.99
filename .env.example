# Client-side env (Vite exposes only VITE_* to the bundle).
# These two keys are PUBLIC by design — security is RLS, not key secrecy (§5.1).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# VAPID *public* key only — the private key lives in Edge Function env (§5.4).
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# -----------------------------------------------------------------------------
# NEVER put these in the client. Set them in Supabase Edge Function secrets only
# (supabase secrets set ...). Listed here purely so it's obvious which is which.
#   SUPABASE_SERVICE_ROLE_KEY=...
#   VAPID_PRIVATE_KEY=...
#   VAPID_SUBJECT=mailto:hello@trolley.app
# -----------------------------------------------------------------------------
